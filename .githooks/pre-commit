#!/bin/sh
# Stamps cache-busting versions on CSS/JS links before every commit, so a
# deploy always shows up straight away. Turn it on once per clone with:
#   git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 0
if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 not found: skipping asset version stamping" >&2
  exit 0
fi
files=$(python3 scripts/stamp-assets.py --list) || exit 0
if [ -n "$files" ]; then
  echo "Stamped asset versions in: $files" >&2
  git add $files
fi
exit 0
